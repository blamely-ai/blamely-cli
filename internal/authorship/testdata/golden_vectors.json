{
  "_comment": "CANONICAL shared golden vectors for the Attribution v2 engine. Go, the VS Code plugin (TS), and the IntelliJ plugin (Kotlin) all run these EXACT cases so the three implementations cannot drift. Each case applies one Attribute(prior, baseline, new, author) and asserts the per-line author type (1-based). 'prior' is the working log describing 'baseline' (null = none, defaults to human). Keep this file in sync across the three repos; it is the contract in docs/attribution-v2-design.md §6.",
  "version": "blamely/golden/1",
  "cases": [
    {
      "name": "new-file-all-ai",
      "prior": null,
      "baseline": "",
      "new": "a\nb\nc",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["ai", "ai", "ai"]
    },
    {
      "name": "empty-new-content",
      "prior": [{ "start": 1, "end": 1, "author": "human" }],
      "baseline": "x",
      "new": "",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": []
    },
    {
      "name": "type-then-ai",
      "prior": [{ "start": 1, "end": 2, "author": "human" }],
      "baseline": "human one\nhuman two",
      "new": "human one\nhuman two\nai a\nai b",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human", "human", "ai", "ai"]
    },
    {
      "name": "duplicate-lines-added-copy-is-ai",
      "prior": [{ "start": 1, "end": 2, "author": "human" }],
      "baseline": "dup\nmid",
      "new": "dup\nmid\ndup",
      "author": { "author": "ai", "tool": "codex", "gen_type": "cli" },
      "expect": ["human", "human", "ai"]
    },
    {
      "name": "whole-file-rewrite-only-new-is-ai",
      "prior": [{ "start": 1, "end": 3, "author": "human" }],
      "baseline": "a\nb\nc",
      "new": "a\nb\nc\nd",
      "author": { "author": "ai", "tool": "copilot", "gen_type": "chat" },
      "expect": ["human", "human", "human", "ai"]
    },
    {
      "name": "edit-middle-line",
      "prior": [{ "start": 1, "end": 3, "author": "human" }],
      "baseline": "a\nb\nc",
      "new": "a\nB\nc",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human", "ai", "human"]
    },
    {
      "name": "delete-keeps-survivors",
      "prior": [{ "start": 1, "end": 3, "author": "human" }],
      "baseline": "a\nb\nc",
      "new": "a\nc",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human", "human"]
    },
    {
      "name": "crlf-stable",
      "prior": [{ "start": 1, "end": 2, "author": "human" }],
      "baseline": "a\r\nb",
      "new": "a\r\nb\r\nc",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human", "human", "ai"]
    },
    {
      "name": "human-overwrites-ai-line",
      "prior": [{ "start": 1, "end": 2, "author": "ai" }],
      "baseline": "ai one\nai two",
      "new": "ai one\nhuman edit",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["ai", "human"],
      "expect_overrode": [null, "ai"]
    },
    {
      "name": "insert-above-shifts-ai-down",
      "prior": [{ "start": 1, "end": 2, "author": "ai" }],
      "baseline": "ai one\nai two",
      "new": "human top\nai one\nai two",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["human", "ai", "ai"]
    },
    {
      "name": "reflow-reindent-keeps-author",
      "prior": [{ "start": 1, "end": 2, "author": "human" }],
      "baseline": "func() {\n  body()",
      "new": "func() {\n        body()",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human", "human"]
    },
    {
      "name": "reflow-trailing-and-internal-whitespace-keeps-author",
      "prior": [{ "start": 1, "end": 1, "author": "ai", "tool": "codex" }],
      "baseline": "a = b + c",
      "new": "a = b + c   ",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["ai"]
    },
    {
      "name": "substantive-change-is-not-reflow",
      "prior": [{ "start": 1, "end": 1, "author": "human" }],
      "baseline": "total = 1",
      "new": "total = 2",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["ai"]
    },
    {
      "name": "reflow-operator-spacing-keeps-author",
      "prior": [{ "start": 1, "end": 1, "author": "human" }],
      "baseline": "x=1",
      "new": "x = 1",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human"]
    },
    {
      "name": "human-rewrite-records-overrode-ai",
      "prior": [{ "start": 1, "end": 2, "author": "ai" }],
      "baseline": "ai a\nai b",
      "new": "human a\nhuman b",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["human", "human"],
      "expect_overrode": ["ai", "ai"]
    },
    {
      "name": "pure-insert-has-no-overrode",
      "prior": [{ "start": 1, "end": 1, "author": "human" }],
      "baseline": "keep",
      "new": "keep\nai added",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human", "ai"],
      "expect_overrode": [null, null]
    },
    {
      "name": "moved-block-keeps-author",
      "prior": [{ "start": 1, "end": 4, "author": "human" }],
      "baseline": "a\nb\nc\nd",
      "new": "c\nd\na\nb",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human", "human", "human", "human"],
      "expect_overrode": [null, null, null, null]
    },
    {
      "name": "move-up-with-genuine-add",
      "prior": [{ "start": 1, "end": 2, "author": "human" }],
      "baseline": "keep\nmoveme",
      "new": "moveme\nkeep\nai new",
      "author": { "author": "ai", "tool": "claude", "gen_type": "chat" },
      "expect": ["human", "human", "ai"],
      "expect_overrode": [null, null, null]
    },
    {
      "name": "ai-block-moved-by-human-stays-ai",
      "prior": [{ "start": 1, "end": 2, "author": "ai", "tool": "copilot" }],
      "baseline": "ai x\nai y",
      "new": "spacer\nai x\nai y",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["human", "ai", "ai"],
      "expect_overrode": [null, null, null]
    },
    {
      "name": "format-quotes-and-semicolon-keep-author",
      "prior": [{ "start": 1, "end": 2, "author": "ai", "tool": "copilot" }],
      "baseline": "const a = \"x\"\nconst b = `y`;",
      "new": "const a = 'x';\nconst b = 'y'",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["ai", "ai"],
      "expect_overrode": [null, null]
    },
    {
      "name": "format-arrow-parens-and-trailing-comma-keep-author",
      "prior": [{ "start": 1, "end": 1, "author": "ai", "tool": "copilot" }],
      "baseline": "  items.map(x => x * 2),",
      "new": "  items.map((x) => x * 2)",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["ai"],
      "expect_overrode": [null]
    },
    {
      "name": "format-split-line-keeps-author",
      "prior": [{ "start": 1, "end": 1, "author": "human" }, { "start": 2, "end": 2, "author": "ai", "tool": "copilot" }, { "start": 3, "end": 3, "author": "human" }],
      "baseline": "start()\nconst opts = { name: 'demo', retries: 3 }\nend()",
      "new": "start()\nconst opts = {\n  name: \"demo\",\n  retries: 3,\n};\nend()",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["human", "ai", "ai", "ai", "ai", "human"],
      "expect_overrode": [null, null, null, null, null, null]
    },
    {
      "name": "format-joined-lines-keep-author",
      "prior": [{ "start": 1, "end": 3, "author": "ai", "tool": "copilot" }],
      "baseline": "if (!raw) {\n  return fallback\n}",
      "new": "if (!raw) { return fallback; }",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["ai"],
      "expect_overrode": [null]
    },
    {
      "name": "format-join-across-authors-goes-to-editor",
      "prior": [{ "start": 1, "end": 1, "author": "ai", "tool": "copilot" }, { "start": 2, "end": 2, "author": "human" }],
      "baseline": "foo(a,\n  b)",
      "new": "foo(a, b);",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["human"],
      "expect_overrode": ["ai"]
    },
    {
      "name": "format-with-real-change-is-not-reflow",
      "prior": [{ "start": 1, "end": 1, "author": "ai", "tool": "copilot" }],
      "baseline": "const opts = { a: 1, b: 2 }",
      "new": "const opts = {\n  a: 1,\n  b: 3,\n}",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["human", "human", "human", "human"]
    },
    {
      "name": "format-return-parens-keep-author",
      "prior": [{ "start": 1, "end": 3, "author": "ai", "tool": "copilot" }],
      "baseline": "function f(a, b) {\n  return a + \" \" + b\n}",
      "new": "function f(a, b) {\n  return (\n    a +\n    ' ' +\n    b\n  );\n}",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["ai", "ai", "ai", "ai", "ai", "ai", "ai"],
      "expect_overrode": [null, null, null, null, null, null, null]
    },
    {
      "name": "format-gap-real-change-after-reflow-keeps-reflow",
      "prior": [{ "start": 1, "end": 2, "author": "ai", "tool": "copilot" }],
      "baseline": "const a = { x: 1, y: 2 }\nconst b = { z: 3 }",
      "new": "const a = {\n  x: 1,\n  y: 2,\n};\nconst b = { z: 4 };",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["ai", "ai", "ai", "ai", "human"]
    },
    {
      "name": "format-gap-real-change-before-reflow-keeps-reflow",
      "prior": [{ "start": 1, "end": 2, "author": "ai", "tool": "copilot" }],
      "baseline": "const b = { z: 3 }\nconst a = { x: 1, y: 2 }",
      "new": "const b = { z: 4 };\nconst a = {\n  x: 1,\n  y: 2,\n};",
      "author": { "author": "human", "gen_type": "human" },
      "expect": ["human", "ai", "ai", "ai", "ai"]
    },
    {
      "name": "format-gap-runs-keep-their-own-author",
      "prior": [{ "start": 1, "end": 1, "author": "ai", "tool": "copilot" }, { "start": 2, "end": 2, "author": "human" }],
      "baseline": "const a = { x: 1, y: 2 }\nconst b = { z: 3, w: 4 }",
      "new": "const a = {\n  x: 1,\n  y: 2,\n};\nconst b = {\n  z: 3,\n  w: 4,\n};",
      "author": { "author": "ai", "tool": "copilot", "gen_type": "cli" },
      "expect": ["ai", "ai", "ai", "ai", "human", "human", "human", "human"],
      "expect_overrode": [null, null, null, null, null, null, null, null]
    }
  ]
}
